{
  "name": "blog",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node ./server/server.js",
    "build": "node ./scripts/build.js",
    "build:watch": "node ./scripts/build.js --watch",
    "dev": "concurrently \"npm:dev:server\" \"npm:build:watch\"",
    "dev:server": "nodemon ./server/server.js -e html,js,hbs",
    "smoke": "node ./scripts/smoke.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "morgan": "^1.11.0",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.2",
    "handlebars": "^4.7.9",
    "jest": "^30.4.2",
    "jquery": "^4.0.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "sass": "^1.102.0"
  },
  "nodemonConfig": {
    "delay": 2500
  }
}
