{
  "name": "blog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "//prepare": "Installs the git hooks. Tolerates failure so `npm ci --omit=dev` and the Docker build, which have neither lefthook nor a .git dir, still succeed.",
    "prepare": "lefthook install || true",
    "start": "node ./server/server.ts",
    "build": "node ./scripts/build.ts",
    "build:watch": "node ./scripts/build.ts --watch",
    "dev": "concurrently \"npm:dev:server\" \"npm:build:watch\"",
    "dev:server": "nodemon ./server/server.ts -e ts,js,cjs,hbs,html",
    "smoke": "node ./scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"server/tests/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"server/tests/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "@types/xml2js": "^0.4.14",
    "concurrently": "^10.0.4",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "esbuild": "^0.28.2",
    "handlebars": "^4.7.9",
    "jquery": "^4.0.0",
    "lefthook": "^2.1.10",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "sass": "^1.102.0",
    "typescript": "^7.0.2"
  },
  "nodemonConfig": {
    "delay": 2500,
    "execMap": {
      "ts": "node",
      "cts": "node",
      "mts": "node"
    }
  }
}
